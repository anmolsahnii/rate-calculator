{
  "manifest_version": 3,
  "name": "3Myle Email Quote Assistant",
  "version": "1.1.2",
  "description": "Rate the open Gmail message using your 3Myle customer rate cards.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Show 3Myle floating quote note" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "web_accessible_resources": [{ "resources": ["panel.html"], "matches": ["https://mail.google.com/*"] }],
  "content_scripts": [{
    "matches": ["https://mail.google.com/*"],
    "js": ["gmail.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://anmolsahnii.github.io"
  }
}
