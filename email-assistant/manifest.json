{
  "manifest_version": 3,
  "name": "3Myle Email Quote Assistant",
  "version": "1.0.0",
  "description": "Rate the open Gmail message using your 3Myle customer rate cards.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "action": { "default_title": "Open 3Myle Quote Assistant" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/*"],
    "js": ["gmail.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://anmolsahnii.github.io"
  }
}
